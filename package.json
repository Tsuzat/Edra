{
	"name": "edra",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.23.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@tiptap/core": "^3.27.1",
		"@tiptap/extension-bubble-menu": "^3.27.1",
		"@tiptap/extension-code-block-lowlight": "^3.27.1",
		"@tiptap/extension-highlight": "^3.27.1",
		"@tiptap/extension-list": "^3.27.1",
		"@tiptap/extension-mathematics": "^3.27.1",
		"@tiptap/extension-subscript": "^3.27.1",
		"@tiptap/extension-superscript": "^3.27.1",
		"@tiptap/extension-table": "^3.27.1",
		"@tiptap/extension-table-of-contents": "^3.27.1",
		"@tiptap/extension-text-align": "^3.27.1",
		"@tiptap/extension-text-style": "^3.27.1",
		"@tiptap/extension-typography": "^3.27.1",
		"@tiptap/extension-unique-id": "^3.27.1",
		"@tiptap/extensions": "^3.27.1",
		"@tiptap/markdown": "^3.27.1",
		"@tiptap/pm": "^3.27.1",
		"@tiptap/starter-kit": "^3.27.1",
		"katex": "^0.17.0"
	}
}
