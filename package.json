{
	"name": "edra",
	"version": "3.1.2",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"registry:build": "bunx shadcn-svelte@latest registry build"
	},
	"bin": {
		"edra": "./bin/cli.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Tsuzat/Edra.git"
	},
	"license": "MIT",
	"files": [
		"dist",
		"bin/",
		"src/lib/edra",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.25.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"@vitest/browser-playwright": "^4.1.10",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.61.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.21",
		"shadcn-svelte": "^1.4.2",
		"shiki": "^4.3.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.1"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/fira-code": "^5.3.0",
		"@google/genai": "^2.13.0",
		"@tiptap/core": "^3.28.0",
		"@tiptap/extension-bubble-menu": "^3.28.0",
		"@tiptap/extension-code-block-lowlight": "^3.28.0",
		"@tiptap/extension-drag-handle": "^3.28.0",
		"@tiptap/extension-highlight": "^3.28.0",
		"@tiptap/extension-image": "^3.28.0",
		"@tiptap/extension-list": "^3.28.0",
		"@tiptap/extension-mathematics": "^3.28.0",
		"@tiptap/extension-subscript": "^3.28.0",
		"@tiptap/extension-superscript": "^3.28.0",
		"@tiptap/extension-table": "^3.28.0",
		"@tiptap/extension-table-of-contents": "^3.28.0",
		"@tiptap/extension-text-align": "^3.28.0",
		"@tiptap/extension-text-style": "^3.28.0",
		"@tiptap/extension-typography": "^3.28.0",
		"@tiptap/extension-unique-id": "^3.28.0",
		"@tiptap/extensions": "^3.28.0",
		"@tiptap/markdown": "^3.28.0",
		"@tiptap/pm": "^3.28.0",
		"@tiptap/starter-kit": "^3.28.0",
		"@tiptap/suggestion": "^3.28.0",
		"fs-extra": "^11.3.6",
		"katex": "^0.17.0",
		"lowlight": "^3.3.0",
		"mermaid": "^11.16.0",
		"motion-sv": "^0.1.13",
		"package-manager-detector": "^0.2.11"
	}
}
