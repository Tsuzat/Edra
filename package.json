{
	"name": "edra",
	"version": "2.4.1",
	"description": "Best Rich Text Editor, made for Svelte Developers with Tiptap",
	"author": {
		"name": "Tsuzat",
		"url": "https://tsuzat.com",
		"email": "edra@tsuzat.com"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"registry:build": "shadcn-svelte registry build"
	},
	"bin": {
		"edra": "./bin/cli.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Tsuzat/Edra.git"
	},
	"license": "MIT",
	"files": [
		"dist",
		"bin/",
		"src/lib/edra",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@fontsource-variable/fira-code": "^5.2.7",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.2.9",
		"@tiptap/extension-drag-handle": "^3.15.3",
		"@tiptap/extension-table-of-contents": "^3.15.3",
		"@tsparticles/slim": "^3.9.1",
		"@tsparticles/svelte": "^3.1.1",
		"@vercel/analytics": "^1.6.1",
		"@vercel/speed-insights": "^1.3.1",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"jsdom": "^26.1.0",
		"mdsvex": "^0.12.6",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.16",
		"shadcn-svelte": "^1.2.7",
		"shiki": "^3.20.0",
		"svelte": "^5.46.0",
		"svelte-check": "^4.3.4",
		"svelte-motion": "^0.12.2",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.49.0",
		"vite": "^6.4.1",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@floating-ui/dom": "^1.7.4",
		"@fontsource-variable/open-sans": "^5.2.7",
		"@google/generative-ai": "^0.24.1",
		"@tiptap/core": "^3.13.0",
		"@tiptap/extension-bubble-menu": "^3.13.0",
		"@tiptap/extension-code-block-lowlight": "^3.13.0",
		"@tiptap/extension-highlight": "^3.13.0",
		"@tiptap/extension-image": "^3.13.0",
		"@tiptap/extension-list": "^3.13.0",
		"@tiptap/extension-mathematics": "^3.13.0",
		"@tiptap/extension-subscript": "^3.13.0",
		"@tiptap/extension-superscript": "^3.13.0",
		"@tiptap/extension-table": "^3.13.0",
		"@tiptap/extension-text-align": "^3.13.0",
		"@tiptap/extension-text-style": "^3.13.0",
		"@tiptap/extension-typography": "^3.13.0",
		"@tiptap/extensions": "^3.13.0",
		"@tiptap/markdown": "^3.13.0",
		"@tiptap/pm": "^3.13.0",
		"@tiptap/starter-kit": "^3.13.0",
		"@tiptap/suggestion": "^3.13.0",
		"fs-extra": "^11.3.2",
		"katex": "^0.16.27",
		"lowlight": "^3.3.0",
		"package-manager-detector": "^1.6.0",
		"svelte-tiptap": "^3.0.1",
		"sveltekit-rate-limiter": "^0.7.0",
		"tiptap-extension-auto-joiner": "^0.1.3"
	}
}
