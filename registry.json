		{
			"name": "edra-shadcn",
			"type": "registry:ui",
			"title": "Edra (shadcn-svelte)",
			"description": "A feature-rich Tiptap rich text editor with toolbar, bubble menu, drag handle, slash commands, image/video/audio embeds, math, and tables — built with shadcn-svelte.",
			"dependencies": [
				"@tiptap/core",
				"@tiptap/extension-bubble-menu",
				"@tiptap/extension-code-block-lowlight",
				"@tiptap/extension-highlight",
				"@tiptap/extension-image",
				"@tiptap/extension-list",
				"@tiptap/extension-mathematics",
				"@tiptap/extension-subscript",
				"@tiptap/extension-superscript",
				"@tiptap/extension-table",
				"@tiptap/extension-table-of-contents",
				"@tiptap/extension-text-align",
				"@tiptap/extension-text-style",
				"@tiptap/extension-typography",
				"@tiptap/extension-drag-handle",
				"@tiptap/extensions",
				"@tiptap/markdown",
				"@tiptap/pm",
				"@tiptap/starter-kit",
				"@tiptap/suggestion",
				"@floating-ui/dom",
				"@lucide/svelte",
				"katex",
				"lowlight",
				"svelte-sonner",
				"svelte-tiptap",
				"tiptap-extension-auto-joiner"
			],
			"registryDependencies": [
				"button",
				"command",
				"dropdown-menu",
				"input",
				"popover",
				"separator",
				"tabs",
				"textarea",
				"tooltip"
			],
			"cssVars": {
				"light": {
					"--border-color": "var(--muted)",
					"--border-color-hover": "var(--muted-foreground)",
					"--blockquote-border": "var(--border)",
					"--blockquote-color": "var(--muted-foreground)",
					"--codeblock-bg": "var(--muted)",
					"--code-bg": "var(--muted)",
					"--table-border": "var(--border)",
					"--table-bg-selected": "color-mix(in oklch, var(--muted) 60%, transparent)",
					"--table-bg-hover": "color-mix(in oklch, var(--muted) 30%, transparent)",
					"--task-completed-color": "var(--muted-foreground)",
					"--highlight-color": "rgba(0, 255, 0, 0.1)",
					"--highlight-border": "green",
					"--search-result-bg": "yellow",
					"--search-result-current-bg": "orange"
				},
				"dark": {
					"--codeblock-bg": "color-mix(in oklch, var(--muted) 30%, transparent)"
				}
			},
			"css": {
				".tiptap a": {
					"color": "var(--color-primary)",
					"text-decoration": "underline"
				}
			},
			"docs": "After installing, add <Toaster /> from svelte-sonner to your root layout. Import the editor with: import { EdraEditor, EdraToolBar, EdraBubbleMenu, EdraDragHandleExtended } from '$lib/components/ui/edra/shadcn/index.js'",
